# Dexter configuration. Copy to .env and fill in what you use.
# Secrets stay on the server: .env and data/ are git-ignored.

# --- Server ---
PORT=3210
HOST=127.0.0.1
# Public URL used for OAuth redirects (must match the Google OAuth client).
PUBLIC_URL=http://localhost:3210
# Optional: require a password to open Dexter (recommended if HOST is not 127.0.0.1).
DEXTER_PASSWORD=
# Optional: extra Host header values allowed (comma separated), e.g. dexter.local
DEXTER_ALLOWED_HOSTS=
# Optional: key used to encrypt stored OAuth tokens. If empty, one is generated in data/secret.key.
DEXTER_SECRET_KEY=
# Where the database and uploaded files live.
DEXTER_DATA_DIR=./data

# --- Claude (assistant model) ---
ANTHROPIC_API_KEY=
# Optional override (rarely needed).
DEXTER_ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Google (Gmail + Calendar) ---
# Create an OAuth client of type "Web application" in Google Cloud Console and add
# PUBLIC_URL/api/integrations/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Visible browser workflows (iLearn / Banner) ---
# Requires `npm install playwright` and `npx playwright install chromium`.
# 1 = run the browser without a window (sign-in handoff then needs a display-less workaround).
DEXTER_BROWSER_HEADLESS=
